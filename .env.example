APP_NAME=WorldPop Population API
DATABASE_URL=sqlite+aiosqlite:////app/data/app.db
TILE_CACHE_DIR=/app/data/tiles
TILE_CACHE_EXPIRY_DAYS=365
TILE_DOWNLOAD_TIMEOUT_SECONDS=120
POP_RADIUS_MIN_METERS=1
POP_RADIUS_MAX_METERS=100000
GEOJSON_MAX_SIZE_BYTES=5242880
GEOJSON_MAX_VERTICES=10000
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
SECRET_KEY=replace-with-at-least-32-random-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_EXPIRE_MINUTES=10080
SESSION_COOKIE_SECURE=false
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SENDER=noreply@example.invalid
